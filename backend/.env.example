NODE_ENV=development
PORT=3000

# Required core settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/df_bot
FB_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-char-secret
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-please

# Web + storage URLs
LANDING_PAGE_URL=http://localhost:3000
STORAGE_PUBLIC_URL=http://localhost:3000/storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Facebook / Meta
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:3000/facebook/callback
FB_OAUTH_STATE_SECRET=replace-with-another-random-secret
FB_WEBHOOK_SECRET=
DEFAULT_VERIFY_TOKEN=local-dev-token
# Shared secret for the one-time app-level Meta Webhooks product handshake
# (Messenger/Instagram/WhatsApp). Unlike DEFAULT_VERIFY_TOKEN, this works in
# production too — it's only used for the app-level verify, not per-request auth.
PLATFORM_VERIFY_TOKEN=

# Google OAuth login ("Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-another-random-secret

# Resend — used to send OTP emails (signup verification + password reset).
# Uses HTTPS, unlike SMTP which most VPS providers block outbound by default.
RESEND_API_KEY=
RESEND_FROM_EMAIL=FlamboyAI <noreply@flamboyai.com>

# Gmail SMTP — legacy, kept as a fallback field but not used by OtpService
# anymore (most VPS providers block outbound SMTP ports).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional OpenAI providers
# Keep this file local only: copy to backend/.env and paste your new key there.
OPENAI_API_KEY=
FALLBACK_AI_PROVIDER=mock
FALLBACK_AI_MODEL=gpt-4o
VISION_PROVIDER=mock
VISION_MODEL=gpt-4o

# Queue
REDIS_URL=redis://127.0.0.1:6379
