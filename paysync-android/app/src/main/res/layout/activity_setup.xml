<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/app_logo"
                android:background="#33FFFFFF"
                android:padding="5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FlamboyAI PaySync"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="প্রথমবার সেটআপ"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stepCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ধাপ ১/৩"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#33FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Progress bar -->
        <android.widget.ProgressBar
            android:id="@+id/setupProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:max="4"
            android:progress="1"
            android:progressTint="#FFFFFF"
            android:progressBackgroundTint="#44FFFFFF" />
    </LinearLayout>

    <!-- Step content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- Big icon -->
        <TextView
            android:id="@+id/stepIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="📱"
            android:textSize="36sp"
            android:background="#EEF2FF"
            android:layout_marginBottom="28dp" />

        <!-- Step title -->
        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS পারমিশন"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <!-- Step description -->
        <TextView
            android:id="@+id/stepDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="10dp" />

        <!-- Why needed note -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEF2FF">

            <TextView
                android:id="@+id/stepWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="..."
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom action area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:paddingTop="12dp"
        android:background="@color/card_bg"
        app:elevation="8dp">

        <!-- Status indicator -->
        <LinearLayout
            android:id="@+id/grantedRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পারমিশন পাওয়া গেছে ✓"
                android:textColor="@color/success"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/actionBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/brand_primary"
            android:text="অনুমতি দিন"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="10dp" />

        <!-- Shown only for battery/autostart steps after opening settings -->
        <Button
            android:id="@+id/confirmDoneBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E8F5E9"
            android:text="✓ আমি সেট করেছি, পরবর্তী ধাপে যাই"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="10dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/skipBtn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@android:color/transparent"
            android:text="পরে দেব (Skip)"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>

</LinearLayout>
